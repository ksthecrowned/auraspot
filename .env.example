DATABASE_URL=
NODE_ENV=development
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
# Domain used for profile URLs and subdomains (jane.auraspot.me)
NEXT_PUBLIC_ROOT_DOMAIN=auraspot.me
RESEND_API_KEY=
# Optional: sender, defaults to "AuraSpot <hello@auraspot.me>"
EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# File storage: Cloudflare R2 (S3 API). Public URL = r2.dev or custom domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional: social OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Vercel API (for custom domains)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=
# Optional: cron job protection
CRON_SECRET=
# Optional: Google Static Maps (map block). Server-side only, restrict it to the Maps Static API
GOOGLE_MAPS_API_KEY=
# AI Gateway API Key
AI_GATEWAY_API_KEY=
# Optional: comma-separated emails allowed to review claims and verification
ADMIN_EMAILS=
# Commission on personality withdrawals, in basis points. 1000 = 10%.
SUPPORT_COMMISSION_BPS=1000
# Optional: bearer secret for payment and payout webhooks
PAYMENTS_WEBHOOK_SECRET=