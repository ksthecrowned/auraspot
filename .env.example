UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=
# Optional: social OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: Vercel API (for custom domains)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=
# Optional: cron job protection
CRON_SECRET=
# AI Gateway API Key
AI_GATEWAY_API_KEY=
