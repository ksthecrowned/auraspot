DATABASE_URL=
NODE_ENV=development
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
# Domain used for profile URLs and subdomains (jane.auraspot.me)
NEXT_PUBLIC_ROOT_DOMAIN=auraspot.me
RESEND_API_KEY=
# Optional: sender, defaults to "AuraSpot <hello@auraspot.me>"
EMAIL_FROM=
